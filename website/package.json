{
    "name": "nasj-website",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": "24.22.2",
        "npm": ">=11 <12"
    },
    "scripts": {
        "dev": "astro dev",
        "check": "astro check && tsc --noEmit -p tsconfig.tools.json",
        "build": "astro build",
        "verify": "node scripts/verify-build.mjs",
        "preview": "node scripts/serve.mjs",
        "test": "playwright test",
        "test:artifacts": "node --test tests/artifacts.test.mjs",
        "demos:ensure": "node scripts/demo-generator.mjs --ensure",
        "test:cache": "node --test tests/demo-cache.test.mjs",
        "demos:fetch": "node scripts/demo-generator.mjs --fetch",
        "demos:generate": "node scripts/demo-generator.mjs --write",
        "demos:verify": "node scripts/demo-generator.mjs --verify",
        "test:demos": "node --test tests/demos.test.mjs",
        "test:update": "playwright test --update-snapshots",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "verify:dependencies": "node scripts/verify-dependencies.mjs",
        "test:content": "node --test tests/content.test.mjs",
        "verify:release": "node scripts/verify-release.mjs"
    },
    "dependencies": {
        "@tailwindcss/vite": "4.3.3",
        "astro": "7.4.4",
        "tailwindcss": "4.3.3"
    },
    "devDependencies": {
        "@astrojs/check": "0.9.12",
        "@axe-core/playwright": "4.14.0",
        "@playwright/test": "1.64.1",
        "@types/node": "24.19.2",
        "cheerio": "1.2.0",
        "esbuild": "0.28.2",
        "prettier": "3.9.10",
        "prettier-plugin-astro": "1.1.2",
        "typescript": "5.9.3"
    }
}
