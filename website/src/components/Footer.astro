---
import Brand from "./Brand.astro";
import { pagePath, repository, type Locale } from "../lib/paths";
interface Props {
    locale: Locale;
}
const { locale } = Astro.props;
const ar = locale === "ar";
---

<footer>
    <div class="wrap footer-inner">
        <div class="footer-brand">
            <Brand />
            <p>
                {ar
                    ? "انسج بنيتك التحتية في صورة واضحة."
                    : "Weave your infrastructure into clarity."}
                <br />
                <a href={pagePath(locale, "licenses")}>
                    {ar
                        ? "مفتوح المصدر. بترخيص MIT."
                        : "Open source. Licensed under MIT."}
                </a>
            </p>
        </div>
        <div class="footer-links">
            <a href={pagePath(locale, "docs")}>
                {ar ? "التوثيق" : "Documentation"}
            </a>
            <a href={`${repository}/blob/main/CONTRIBUTING.md`}>
                {ar ? "ساهم في المشروع" : "Contribute"}
            </a>
            <a href={repository}>GitHub ↗</a>
            <small>
                {ar ? "مستقل عن F5 وNGINX." : "Independent of F5 and NGINX."}
            </small>
        </div>
    </div>
</footer>
