---
import SiteLayout from "../layouts/SiteLayout.astro";
import { asset, type Locale } from "../lib/paths";
import metadata from "../data/demos.json";
import multi from "../../public/demos/v0.1.0/multi-vhost.json";
import unresolved from "../../public/demos/v0.1.0/unresolved.json";
import multiSource from "../../../fixtures/nginx/multi-vhost.conf?raw";
import unresolvedSource from "../../fixtures/unresolved/nginx.conf?raw";
import routesSource from "../../fixtures/unresolved/routes.conf?raw";
import "../styles/demo.css";
interface Props {
    locale: Locale;
}
const { locale } = Astro.props;
const ar = locale === "ar";
const text = (en: string, arabic: string) => (ar ? arabic : en);
const scenarios = [
    {
        metadata: metadata.scenarios[0]!,
        graph: multi,
        title: text("Multiple virtual hosts", "مضيفون افتراضيون متعددون"),
        summary: text(
            "The portal’s / location proxies to portal_app, which is backed by 127.0.0.1:8100 and a backup endpoint. The API uses api_app. Redirect conditions remain symbolic configuration expressions, not verified requests.",
            "يوجّه المسار / في البوابة إلى portal_app، الذي يرتبط بـ 127.0.0.1:8100 وبنقطة احتياطية. تستخدم الواجهة البرمجية api_app. تبقى شروط إعادة التوجيه تعبيرات رمزية من الإعدادات، وليست طلبات جرى التحقق منها.",
        ),
        sources: [multiSource],
    },
    {
        metadata: metadata.scenarios[1]!,
        graph: unresolved,
        title: text("An unresolved dynamic route", "مسار ديناميكي غير محسوم"),
        summary: text(
            "The included /dynamic/ location uses http://$backend. NASJ cannot resolve that variable statically: it reports one warning and creates no proxy target or proxy relationship.",
            "يستخدم المسار المُضمَّن /dynamic/ القيمة http://$backend. لا يستطيع نسج تحديد قيمة المتغير بالتحليل الساكن؛ فيصدر تحذيرًا واحدًا دون إنشاء هدف أو علاقة توجيه وهمية.",
        ),
        sources: [unresolvedSource, routesSource],
    },
];
const sourceId = (scenario: string, path: string, line: number) =>
    `${scenario}-${path.replace(/[^a-z0-9]/gi, "-")}-${line}`;
const evidence = (source: { path: string; line: number }) =>
    `${source.path}:${source.line}`;
---

<SiteLayout
    locale={locale}
    demoPage
    title={text("Authentic report demo — NASJ", "تجربة تقرير أصلي — نسج")}
>
    <section class="demo-intro">
        <p class="section-eyebrow">
            {text(
                "PINNED RELEASE · SYNTHETIC CONFIGURATION",
                "إصدار مثبت · إعدادات اصطناعية",
            )}
        </p>
        <h1>{text("Explore the evidence.", "استكشف الأدلة.")}</h1>
        <p class="demo-lead">
            {text(
                "Two genuine reports generated by NASJ v0.1.0. Follow configured relationships back to their source files and lines.",
                "تقريران أصليان أُنشئا باستخدام نسج v0.1.0. تتبّع العلاقات المعرَّفة في الإعدادات إلى ملفاتها وأسطرها المصدرية.",
            )}
        </p>
        <p>
            {text(
                "This is configuration analysis, not runtime verification. NASJ does not contact these synthetic hosts, check their health, or prove that Nginx loaded this configuration.",
                "هذا تحليل للإعدادات، وليس تحققًا وقت التشغيل. لا يتصل نسج بهذه المضيفات الاصطناعية، ولا يفحص حالتها، ولا يثبت أن Nginx حمّل هذه الإعدادات.",
            )}
        </p>
        <p>
            {text(
                "The original report viewer is English-only and keeps its own theme. The explanations and evidence below are available in English and Arabic.",
                "عارض التقرير الأصلي باللغة الإنجليزية فقط وله مظهره المستقل. تتوفر الشروح والأدلة أدناه باللغتين العربية والإنجليزية.",
            )}
        </p>
    </section>
    {scenarios.map(
        ({ metadata: scenario, graph, title, summary, sources }, index) => (
            <section
                class="demo-scenario"
                id={scenario.id}
                aria-labelledby={`${scenario.id}-title`}
            >
                <p class="section-eyebrow">
                    {text(`SCENARIO ${index + 1}`, `المثال ${index + 1}`)}
                </p>
                <h2 id={`${scenario.id}-title`}>{title}</h2>
                <p>{summary}</p>
                <p class="demo-stats">
                    {text(
                        `${graph.nodes.length} nodes · ${graph.edges.length} configured relationships · ${graph.warnings.length} diagnostics`,
                        `${graph.nodes.length} عقدة · ${graph.edges.length} علاقة معرَّفة في الإعدادات · ${graph.warnings.length} رسائل تشخيصية`,
                    )}
                </p>
                <ul class="demo-diagnostics">
                    {graph.warnings.map((warning) => (
                        <li>
                            <bdi dir="ltr">
                                <code>{warning.code}</code>
                            </bdi>
                            {" — "}
                            {warning.severity === "info"
                                ? text(
                                      "Information: the optional include pattern matched no files.",
                                      "معلومة: لم يطابق نمط التضمين الاختياري أي ملفات.",
                                  )
                                : text(
                                      "Warning: variable proxy_pass cannot be resolved statically.",
                                      "تحذير: لا يمكن حسم proxy_pass الذي يحتوي على متغير بالتحليل الساكن.",
                                  )}{" "}
                            <a
                                href={`#${sourceId(scenario.id, warning.source.path, warning.source.line)}`}
                            >
                                <bdi dir="ltr">{evidence(warning.source)}</bdi>
                            </a>
                        </li>
                    ))}
                </ul>
                <p>
                    {text(
                        "Try searching for a host or backend, select a result, and inspect its source evidence. Tab reaches report controls and graph nodes; Enter selects a node and Escape clears selection.",
                        "جرّب البحث عن مضيف أو خادم خلفي، ثم اختر نتيجة وافحص دليلها المصدري. ينقلك Tab بين عناصر التحكم والعقد؛ يحدد Enter عقدة ويلغي Escape التحديد.",
                    )}
                </p>
                <iframe
                    class="demo-viewer"
                    src={asset(`demos/v0.1.0/${scenario.id}.html`)}
                    title={text(
                        `${title} — original English NASJ report`,
                        `${title} — تقرير نسج الأصلي بالإنجليزية`,
                    )}
                    sandbox="allow-scripts"
                    referrerpolicy="no-referrer"
                    loading="lazy"
                    lang={locale}
                    dir="ltr"
                />
                <div class="demo-actions">
                    <a
                        class="button primary"
                        data-open-report
                        href={asset(`demos/v0.1.0/${scenario.id}.html`)}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {text(
                            "Open standalone report ↗",
                            "افتح التقرير المستقل ↗",
                        )}
                    </a>
                    <a
                        class="button"
                        data-download-report
                        href={asset(`demos/v0.1.0/${scenario.id}.html`)}
                        download={`${scenario.id}.html`}
                    >
                        {text(
                            "Download offline HTML",
                            "نزّل HTML للعمل دون اتصال",
                        )}
                    </a>
                    {(["json", "dot", "svg"] as const).map((format) => (
                        <a
                            href={asset(
                                `demos/v0.1.0/${scenario.id}.${format}`,
                            )}
                            download={`${scenario.id}.${format}`}
                        >
                            <bdi dir="ltr">{format.toUpperCase()}</bdi>
                        </a>
                    ))}
                </div>
                <p class="demo-boundary">
                    {text(
                        "The embedded report runs in a restrictive sandbox. Opening the standalone report leaves that sandbox; the report retains its own released Content Security Policy. The downloaded HTML works by itself, offline. Without JavaScript, its static diagram and the evidence below remain available.",
                        "يعمل التقرير المضمَّن داخل بيئة معزولة مقيّدة. فتح التقرير المستقل يغادر هذه البيئة، مع الاحتفاظ بسياسة أمان المحتوى الأصلية للتقرير. يعمل ملف HTML المنزَّل بمفرده دون اتصال. عند تعطيل JavaScript، يبقى الرسم الثابت والأدلة أدناه متاحين.",
                    )}
                </p>
                <details class="demo-evidence" open>
                    <summary>
                        {text(
                            "Accessible topology and source evidence",
                            "بنية العلاقات والأدلة المصدرية القابلة للوصول",
                        )}
                    </summary>
                    <p>
                        {text(
                            "All relationships below are configured, not runtime-confirmed. Labels are the literal values from the synthetic fixture.",
                            "جميع العلاقات أدناه معرَّفة في الإعدادات ولم يجرِ التحقق منها وقت التشغيل. التسميات هي القيم الحرفية من المثال الاصطناعي.",
                        )}
                    </p>
                    <div
                        class="demo-table"
                        role="region"
                        tabindex="0"
                        aria-label={text(
                            "Configured relationships",
                            "العلاقات المعرَّفة في الإعدادات",
                        )}
                    >
                        <table>
                            <caption>
                                {text(
                                    "Configured relationships and exact source lines",
                                    "العلاقات المعرَّفة وأسطرها المصدرية الدقيقة",
                                )}
                            </caption>
                            <thead>
                                <tr>
                                    {[
                                        text("From", "من"),
                                        text("Relationship", "العلاقة"),
                                        text("To", "إلى"),
                                        text("Evidence", "الدليل"),
                                    ].map((label) => (
                                        <th scope="col">{label}</th>
                                    ))}
                                </tr>
                            </thead>
                            <tbody>
                                {graph.edges.map((edge) => (
                                    <tr>
                                        <td>
                                            <bdi dir="ltr">
                                                {
                                                    graph.nodes.find(
                                                        (node) =>
                                                            node.id ===
                                                            edge.from,
                                                    )?.label
                                                }
                                            </bdi>
                                        </td>
                                        <td>
                                            <bdi dir="ltr">
                                                <code>{edge.kind}</code>
                                            </bdi>
                                        </td>
                                        <td>
                                            <bdi dir="ltr">
                                                {
                                                    graph.nodes.find(
                                                        (node) =>
                                                            node.id === edge.to,
                                                    )?.label
                                                }
                                            </bdi>
                                        </td>
                                        <td>
                                            <a
                                                href={`#${sourceId(scenario.id, edge.source.path, edge.source.line)}`}
                                            >
                                                <bdi dir="ltr">
                                                    {evidence(edge.source)}
                                                </bdi>
                                            </a>
                                        </td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                    <ul class="demo-nodes">
                        {graph.nodes.map((node) => (
                            <li>
                                <bdi dir="ltr">
                                    <code>{node.kind}</code>: {node.label}
                                </bdi>
                                {" — "}
                                <a
                                    href={`#${sourceId(scenario.id, node.source.path, node.source.line)}`}
                                >
                                    <bdi dir="ltr">{evidence(node.source)}</bdi>
                                </a>
                            </li>
                        ))}
                    </ul>
                    {scenario.fixtures.map((fixture, sourceIndex) => (
                        <details class="demo-source">
                            <summary>
                                <bdi dir="ltr">{fixture.path}</bdi>
                            </summary>
                            <ol dir="ltr">
                                {sources[sourceIndex]!.trimEnd()
                                    .split("\n")
                                    .map((line, i) => (
                                        <li
                                            id={sourceId(
                                                scenario.id,
                                                fixture.path,
                                                i + 1,
                                            )}
                                        >
                                            <code>{line || " "}</code>
                                        </li>
                                    ))}
                            </ol>
                        </details>
                    ))}
                </details>
                <details class="demo-provenance">
                    <summary>
                        {text(
                            "Artifact provenance and SHA-256",
                            "مصدر الملفات وبصمات SHA-256",
                        )}
                    </summary>
                    <p>
                        {text(
                            "Generated with the pinned published Linux x86_64 executable, NASJ v0.1.0. Only source-root prefixes were normalized; the released viewer code, styling and CSP are unchanged.",
                            "أُنشئت الملفات بالنسخة التنفيذية المنشورة والمثبتة Linux x86_64 من نسج v0.1.0. اقتصر التعديل على بادئات مسارات المصدر؛ لم تتغير شيفرة العارض أو تنسيقاته أو سياسة أمانه.",
                        )}
                    </p>
                    <dl>
                        <dt>{text("Release commit", "التزام الإصدار")}</dt>
                        <dd>
                            <bdi dir="ltr">
                                <code>{metadata.generator.commit}</code>
                            </bdi>
                        </dd>
                        <dt>
                            {text("Executable SHA-256", "بصمة الملف التنفيذي")}
                        </dt>
                        <dd>
                            <bdi dir="ltr">
                                <code>
                                    {metadata.generator.executable_sha256}
                                </code>
                            </bdi>
                        </dd>
                        {scenario.outputs.map((output) => (
                            <>
                                <dt>
                                    <bdi dir="ltr">{output.path}</bdi>
                                </dt>
                                <dd>
                                    <bdi dir="ltr">
                                        <code>{output.sha256}</code>
                                    </bdi>
                                </dd>
                            </>
                        ))}
                    </dl>
                </details>
            </section>
        ),
    )}
</SiteLayout>
